# ============================================================
# Kayi Image Compressor — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- REQUIRED ---
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
WEBHOOK_BASE_URL=https://YOUR_RENDER_SERVICE.onrender.com

# --- SECURITY ---
# Optional but strongly recommended. Set a random secret for Telegram to include
# in webhook requests (X-Telegram-Bot-Api-Secret-Token header).
WEBHOOK_SECRET=

# --- SERVER ---
PORT=10000

# --- BRANDING ---
# Set to your bot's @username after registering with BotFather
BOT_USERNAME=KayiImgShrinkBot

# --- FORCE SUBSCRIBE ---
# Set to true to require users to join @KayiBots before using the bot.
FSUB_ENABLED=false
FSUB_CHANNEL=@KayiBots
FSUB_CHANNEL_URL=https://t.me/KayiBots

# --- OPTIONAL: WELCOME VIDEO ---
# After your first /start, copy the file_id from logs and paste here.
# Leave blank to skip the welcome video.
WELCOME_VIDEO_FILE_ID=

# --- LIMITS ---
MAX_UPLOAD_MB=8
MAX_IMAGE_PIXELS=12000000
MAX_QUEUE_SIZE=5
MAX_CONCURRENT_JOBS=1
PROCESSING_TIMEOUT_SECONDS=25
DAILY_USER_LIMIT=20
SESSION_TTL_SECONDS=600

# --- LOGGING ---
LOG_LEVEL=INFO

# --- OWNER / LOGGING ---
OWNER_ID=
LOG_CHANNEL_ID=

# --- RENDER HOSTING METRICS ---
RENDER_EMAIL=
RENDER_SERVICE_NAME=kayi-image-compressor
RENDER_REPO=ZenkaiRPGBot/kayi-image-compressor
RENDER_USED_HOURS=0.0
